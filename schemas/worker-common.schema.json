{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/worker-common.schema.json",
  "title": "AgentOS Worker Common Definitions",
  "description": "Reusable definitions shared by AgentOS Worker Protocol schemas.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Opaque stable identifier within its owning domain."
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Capability name used for Worker selection. Names may be namespaced with dots, hyphens, or underscores."
    },
    "semanticName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Open semantic name suitable for plugin-defined kinds."
    },
    "inputBinding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Opaque binding for the exact correctness-bearing input of an assignment."
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1,
      "format": "uri-reference",
      "description": "URI reference identifying a JSON Schema."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference",
          "description": "Resolvable or opaque URI reference to context, evidence, or another durable resource."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "description": "Optional media type describing the referenced resource."
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "description": "The run-specific outcome the Worker should pursue."
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Plugin-owned non-core extension data. Correctness-bearing core semantics should use first-class fields instead.",
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/semanticName"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {}
      }
    }
  }
}
