{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:schema:worker-common",
  "title": "AgentOS Worker Common Definitions",
  "description": "Reusable definitions shared by the AgentOS Worker Protocol schemas.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Opaque identifier owned by its application domain."
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Capability name used for Worker selection. Namespaced names are allowed."
    },
    "semanticName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Open semantic name suitable for plugin-defined kinds."
    },
    "inputBinding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Opaque binding for the exact correctness-bearing input of an assignment."
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1,
      "format": "uri-reference",
      "description": "URI reference identifying the JSON Schema used to validate a payload."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference",
          "description": "Reference to context, evidence, or another durable resource."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "description": "Optional media type of the referenced resource."
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/semanticName"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "description": "Logical source of structured input or evidence."
    },
    "extensions": {
      "type": "object",
      "description": "Plugin-owned extension data keyed by an absolute URI namespace. Core correctness semantics should use first-class fields.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/semanticName"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {}
      }
    }
  }
}
