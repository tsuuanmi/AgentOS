{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:schema:worker-submission",
  "title": "AgentOS Worker Submission",
  "description": "Intermediate or terminal output submitted by a Website-backed Worker.",
  "oneOf": [
    {
      "$ref": "#/$defs/contribution"
    },
    {
      "$ref": "#/$defs/completion"
    },
    {
      "$ref": "#/$defs/inputRequired"
    },
    {
      "$ref": "#/$defs/failure"
    },
    {
      "$ref": "#/$defs/cancelled"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "submissionId",
        "workerId",
        "assignmentId",
        "attemptId",
        "inputBinding",
        "kind"
      ],
      "properties": {
        "submissionId": {
          "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
        },
        "workerId": {
          "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
        },
        "assignmentId": {
          "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
        },
        "attemptId": {
          "$ref": "urn:agentos:schema:worker-common#/$defs/identifier",
          "description": "Current Website execution attempt for this assignment. A superseded attempt cannot commit."
        },
        "inputBinding": {
          "$ref": "urn:agentos:schema:worker-common#/$defs/inputBinding"
        },
        "kind": {
          "type": "string",
          "enum": [
            "contribution",
            "completion",
            "input_required",
            "failure",
            "cancelled"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:agentos:schema:worker-common#/$defs/reference"
          }
        },
        "extensions": {
          "$ref": "urn:agentos:schema:worker-common#/$defs/extensions"
        }
      }
    },
    "contribution": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "contribution"
            },
            "outputSchemaRef": {
              "$ref": "urn:agentos:schema:worker-common#/$defs/schemaRef"
            },
            "output": {
              "description": "Intermediate typed output validated against outputSchemaRef."
            }
          },
          "required": [
            "outputSchemaRef",
            "output"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "completion": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "completion"
            },
            "outputSchemaRef": {
              "$ref": "urn:agentos:schema:worker-common#/$defs/schemaRef"
            },
            "output": {
              "description": "Terminal typed output validated against outputSchemaRef."
            }
          },
          "required": [
            "outputSchemaRef",
            "output"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "inputRequired": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "input_required"
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "message"
              ],
              "properties": {
                "kind": {
                  "$ref": "urn:agentos:schema:worker-common#/$defs/semanticName"
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "schemaRef": {
                  "$ref": "urn:agentos:schema:worker-common#/$defs/schemaRef"
                }
              }
            }
          },
          "required": [
            "request"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "failure": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "failure"
            },
            "error": {
              "$ref": "urn:agentos:schema:worker-common#/$defs/error"
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "cancelled": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cancelled"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
