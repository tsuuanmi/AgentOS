{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:schema:mcp-worker-inspect-result",
  "title": "AgentOS MCP Worker Inspect Result",
  "description": "Returns current state only to the current attempt; stale callers receive a non-disclosing superseded result.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "state"
      ],
      "properties": {
        "status": {
          "const": "current"
        },
        "state": {
          "$ref": "urn:agentos:schema:worker-state"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "superseded"
        }
      }
    }
  ]
}
