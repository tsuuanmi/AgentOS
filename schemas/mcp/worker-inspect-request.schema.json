    "workerId",
    "assignmentId",
    "attemptId"
  ],
  "properties": {
    "workerId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "assignmentId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "attemptId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    }
  }
}
