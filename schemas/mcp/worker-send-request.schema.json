{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:schema:mcp-worker-send-request",
  "title": "AgentOS MCP Worker Send Request",
  "description": "Sends one Worker Message from the Website execution to the local Worker server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attemptId",
    "message"
  ],
  "properties": {
    "attemptId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "message": {
      "$ref": "urn:agentos:schema:worker-message"
    }
  }
}
