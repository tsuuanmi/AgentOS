{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:schema:mcp-worker-claim-result",
  "title": "AgentOS MCP Worker Claim Result",
  "description": "Returns an assignment with its current provider execution attempt, or an explicit no-work result.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attemptId",
        "assignment"
      ],
      "properties": {
        "status": {
          "const": "assignment"
        },
        "attemptId": {
          "$ref": "urn:agentos:schema:worker-common#/$defs/identifier",
          "description": "Current provider execution attempt for attempt-scoped Worker operations."
        },
        "assignment": {
          "$ref": "urn:agentos:schema:worker-assignment"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "no_work"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    }
  ],
  "type": "object"
}
