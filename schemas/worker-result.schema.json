{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/worker-result.schema.json",
  "title": "AgentOS Worker Result",
  "description": "Durable lifecycle state or terminal result for one Worker assignment.",
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "pending"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "running"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "input_required"
            },
            "inputRequest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "message"
              ],
              "properties": {
                "kind": {
                  "$ref": "worker-common.schema.json#/$defs/semanticName"
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "schemaRef": {
                  "$ref": "worker-common.schema.json#/$defs/schemaRef"
                }
              }
            }
          },
          "required": [
            "inputRequest"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "completed"
            },
            "outputSchemaRef": {
              "$ref": "worker-common.schema.json#/$defs/schemaRef"
            },
            "output": {
              "description": "Terminal output validated against outputSchemaRef."
            }
          },
          "required": [
            "outputSchemaRef",
            "output"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "failed"
            },
            "error": {
              "$ref": "worker-common.schema.json#/$defs/error"
            }
          },
          "required": [
            "error"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "assignmentId",
        "inputBinding",
        "status"
      ],
      "properties": {
        "assignmentId": {
          "$ref": "worker-common.schema.json#/$defs/identifier"
        },
        "inputBinding": {
          "$ref": "worker-common.schema.json#/$defs/inputBinding"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "input_required",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "worker-common.schema.json#/$defs/reference"
          }
        },
        "extensions": {
          "$ref": "worker-common.schema.json#/$defs/extensions"
        }
      }
    }
  }
}
