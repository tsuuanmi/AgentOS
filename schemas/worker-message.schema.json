{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/worker-message.schema.json",
  "title": "AgentOS Worker Message",
  "description": "Structured peer-to-peer Team message between Worker instances.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "kind",
    "fromWorker",
    "toWorker",
    "sourceAssignmentId",
    "targetAssignmentId",
    "inputBinding",
    "payloadSchemaRef",
    "payload"
  ],
  "properties": {
    "messageId": {
      "$ref": "worker-common.schema.json#/$defs/identifier"
    },
    "kind": {
      "$ref": "worker-common.schema.json#/$defs/semanticName"
    },
    "fromWorker": {
      "$ref": "worker-common.schema.json#/$defs/identifier"
    },
    "toWorker": {
      "$ref": "worker-common.schema.json#/$defs/identifier"
    },
    "sourceAssignmentId": {
      "$ref": "worker-common.schema.json#/$defs/identifier"
    },
    "targetAssignmentId": {
      "$ref": "worker-common.schema.json#/$defs/identifier"
    },
    "inputBinding": {
      "$ref": "worker-common.schema.json#/$defs/inputBinding"
    },
    "payloadSchemaRef": {
      "$ref": "worker-common.schema.json#/$defs/schemaRef"
    },
    "payload": {
      "description": "Structured message payload validated against payloadSchemaRef."
    },
    "inReplyTo": {
      "$ref": "worker-common.schema.json#/$defs/identifier"
    },
    "extensions": {
      "$ref": "worker-common.schema.json#/$defs/extensions"
    }
  }
}
