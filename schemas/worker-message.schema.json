{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:schema:worker-message",
  "title": "AgentOS Worker Message",
  "description": "Non-authoritative structured communication associated with a Worker assignment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "workerId",
    "assignmentId",
    "inputBinding",
    "kind",
    "payloadSchemaRef",
    "payload"
  ],
  "properties": {
    "messageId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "workerId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "assignmentId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "inputBinding": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/inputBinding"
    },
    "kind": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/semanticName"
    },
    "source": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/source"
    },
    "payloadSchemaRef": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/schemaRef"
    },
    "payload": {
      "description": "Structured communication payload validated by the server against payloadSchemaRef."
    },
    "inReplyTo": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "extensions": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/extensions"
    }
  }
}
