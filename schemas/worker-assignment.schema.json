{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:schema:worker-assignment",
  "title": "AgentOS Worker Assignment",
  "description": "A self-contained unit of capability-driven work offered to one Worker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workerId",
    "assignmentId",
    "requiredCapabilities",
    "objective",
    "inputBinding",
    "expectedOutput"
  ],
  "properties": {
    "workerId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "assignmentId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:agentos:schema:worker-common#/$defs/capability"
      }
    },
    "objective": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/objective"
    },
    "inputBinding": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/inputBinding"
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "urn:agentos:schema:worker-common#/$defs/reference"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptedResults": {
      "type": "array",
      "items": {
        "$ref": "urn:agentos:schema:worker-common#/$defs/reference"
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef"
      ],
      "properties": {
        "schemaRef": {
          "$ref": "urn:agentos:schema:worker-common#/$defs/schemaRef"
        }
      }
    },
    "extensions": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/extensions"
    }
  }
}
