{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:schema:worker-artifact",
  "title": "AgentOS Worker Artifact",
  "description": "Durable intermediate or terminal Worker work product.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "workerId",
    "assignmentId",
    "attemptId",
    "inputBinding",
    "kind",
    "schemaRef",
    "data"
  ],
  "properties": {
    "artifactId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "workerId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "assignmentId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "attemptId": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/identifier"
    },
    "inputBinding": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/inputBinding"
    },
    "kind": {
      "type": "string",
      "enum": [
        "contribution",
        "completion"
      ]
    },
    "schemaRef": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/schemaRef"
    },
    "data": {
      "description": "Artifact data validated by the server against schemaRef."
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:agentos:schema:worker-common#/$defs/reference"
      }
    },
    "extensions": {
      "$ref": "urn:agentos:schema:worker-common#/$defs/extensions"
    }
  }
}
