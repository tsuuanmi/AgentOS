{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/worker-capabilities.schema.json",
  "title": "AgentOS Worker Capabilities",
  "description": "Capabilities advertised by a Worker binding or provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workerId",
    "capabilities"
  ],
  "properties": {
    "workerId": {
      "$ref": "worker-common.schema.json#/$defs/identifier"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "worker-common.schema.json#/$defs/capability"
      }
    },
    "extensions": {
      "$ref": "worker-common.schema.json#/$defs/extensions"
    }
  }
}
